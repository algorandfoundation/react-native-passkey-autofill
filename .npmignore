# Exclude all top-level hidden directories by convention
/.*/

# Exclude tarballs generated by `npm pack`
/*.tgz

# The vendored keystore tarballs are a development-time stand-in for the
# unpublished packages (see vendor/README.md). Shipping them would install a
# SECOND copy of the native keystore module inside a consumer's node_modules;
# consumers point the dependency at their own copy through an override instead.
/vendor/

__mocks__
__tests__

/babel.config.js
/android/src/androidTest/
/android/src/test/
/android/build/
/example/
